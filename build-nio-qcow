#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Build an MS-DOS qcow2 image containing the NIO FUJINET.SYS driver.

Driver-only output defaults to build/msdos-nio.qcow2.
When --apps-manifest is used, output defaults to build/msdos-nio-apps.qcow2.

Options:
  -b, --base <image>           Base MS-DOS disk image, raw or qcow2 (env: BASE_IMAGE, required)
  -o, --output <image>         Output qcow2 image (env: OUTPUT_IMAGE)
  -r, --driver-repo <path>     fujinet-nio-driver repository (env: FUJINET_NIO_DRIVER)
  -d, --driver <path>          FUJINET.SYS to inject (env: DRIVER)
      --apps-manifest <file>   YAML app manifest (env: APPS_MANIFEST)
      --apps-dir <dir>         DOS directory for apps (env: APPS_DIR, default: FNAPPS)
      --fuji-bps <bps>         CONFIG.SYS FUJI_BPS value (env: FUJI_BPS, default: 115200)
      --fuji-port <port>       CONFIG.SYS FUJI_PORT value (env: FUJI_PORT)
  -h, --help                   Show this help message

Required: BASE_IMAGE and FUJINET_NIO_DRIVER. This repository does not ship an
MS-DOS image: build one with qemu-msdos-init from your own MS-DOS install disks.

Repository paths (relative to this repo unless absolute):
  FUJINET_NIO_DRIVER (required)

App paths are listed in manifests/apps.example.yaml. Copy it to
manifests/apps.yaml and set NIO_CORE_APPS_MSDOS_BIN, NIO_APPS_MSDOS_BIN and
NIO_CONFIG_MSDOS_BIN before building with --apps-manifest.

Examples:
  BASE_IMAGE=/path/to/msdos622.img \\
    FUJINET_NIO_DRIVER=/path/to/fujinet-nio-driver $(basename "$0")
  BASE_IMAGE=/path/to/msdos622.img FUJI_BPS=9600 \\
    FUJINET_NIO_DRIVER=/path/to/fujinet-nio-driver $(basename "$0")
  BASE_IMAGE=/path/to/msdos622.img FUJINET_NIO_DRIVER=/path/to/fujinet-nio-driver \\
    NIO_CORE_APPS_MSDOS_BIN=/path/to/nio-core-apps/build/msdos/bin \\
    NIO_APPS_MSDOS_BIN=/path/to/nio-apps/build/msdos/bin \\
    NIO_CONFIG_MSDOS_BIN=/path/to/nio-config/build/msdos/bin \\
    $(basename "$0") --apps-manifest manifests/apps.yaml
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "Missing required tool: uv" >&2
    echo "Install uv (see fujinet-nio README prerequisites)." >&2
    exit 1
fi

exec uv run --directory "$SCRIPT_DIR" fujinet-qemu-msdos "$@"
